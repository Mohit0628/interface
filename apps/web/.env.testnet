# ──────────────────────────────────────────────────────────────────────────────
# SO4 — Testnet environment
# Load with: vite build --mode testnet  (or vite dev --mode testnet)
# Contract addresses are committed in packages/contracts/contracts.json.
# ──────────────────────────────────────────────────────────────────────────────

VITE_NETWORK=testnet

VITE_RPC_URL=https://soroban-testnet.stellar.org
VITE_HORIZON_URL=https://horizon-testnet.stellar.org

# Optional — remove to fall back to GMX infra
# VITE_ORACLE_URL=https://arbitrum-api.gmxinfra.io

# Pyth Hermes endpoint for on-chain price attestations
# VITE_PYTH_HERMES_URL=https://hermes.pyth.network

# SubQuery GraphQL endpoint for indexed historical data
# VITE_INDEXER_GRAPHQL_URL=http://localhost:3000
