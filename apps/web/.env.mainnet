# ──────────────────────────────────────────────────────────────────────────────
# SO4 — Mainnet environment
# Load with: vite build --mode mainnet
# Contract addresses are committed in packages/contracts/contracts.json.
#
# Use a dedicated RPC provider for production.
# Provider list: https://developers.stellar.org/docs/data/apis/rpc/providers
# ──────────────────────────────────────────────────────────────────────────────

VITE_NETWORK=mainnet

# Replace with your chosen mainnet RPC provider
VITE_RPC_URL=https://your-mainnet-rpc-provider.example.com
VITE_HORIZON_URL=https://horizon.stellar.org

# Optional — remove to fall back to GMX infra
# VITE_ORACLE_URL=https://arbitrum-api.gmxinfra.io

# Pyth Hermes endpoint for on-chain price attestations
# VITE_PYTH_HERMES_URL=https://hermes.pyth.network

# SubQuery GraphQL endpoint for indexed historical data
# VITE_INDEXER_GRAPHQL_URL=https://your-mainnet-indexer.example.com
