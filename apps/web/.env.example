# ──────────────────────────────────────────────────────────────────────────────
# SO4 — Environment variables
# Copy this file to .env.local (for local dev) and customize if needed.
# Contract addresses are committed in packages/contracts/contracts.json.
# All VITE_ vars are inlined by Vite at build time and visible in the bundle.
# Never put private keys or secrets in VITE_ variables.
# ──────────────────────────────────────────────────────────────────────────────

# ── Network ───────────────────────────────────────────────────────────────────

# "testnet" | "mainnet"
VITE_NETWORK=testnet

# ── RPC / Horizon ─────────────────────────────────────────────────────────────
# Soroban JSON-RPC endpoint.
# Provider list: https://developers.stellar.org/docs/data/apis/rpc/providers
VITE_RPC_URL=https://soroban-testnet.stellar.org

# Horizon REST API endpoint.
VITE_HORIZON_URL=https://horizon-testnet.stellar.org

# ── Oracle ────────────────────────────────────────────────────────────────────
# Price-feed base URL. Optional — falls back to GMX infra if unset.
# VITE_ORACLE_URL=https://arbitrum-api.gmxinfra.io

# Pyth Hermes prices default to the same-origin Nitro proxy.
# Set PYTH_API_KEY on the SERVER, never in any VITE_ variable.
# Without a server API key, Pyth prices are unavailable and the UI labels fallbacks.
# PYTH_API_KEY=your-server-side-secret
# If an approved public keyless Hermes provider is available, you can use:
# VITE_PYTH_HERMES_URL=https://your-public-hermes-provider.example.com

# ── SubQuery Indexer ──────────────────────────────────────────────────────────
# SubQuery GraphQL endpoint for indexed historical data.
# Optional — when not set, indexer is disabled and app uses degraded fallback behavior.
# Local development default: http://localhost:3000
# VITE_INDEXER_GRAPHQL_URL=http://localhost:3000
